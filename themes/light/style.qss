*[shadeBackground=true] { 
    background: QLinearGradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 rgb(220,235,255), stop: 1 rgb(167,173,193));
}
    
QPushButton[flat=true]:hover:!pressed { 
    border: 2px outset #8f8f91;
}

QListView::item:selected {
    background-color: #cde8ff;
    color: #1a1a1a;
}